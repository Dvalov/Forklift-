# ==============================================================================
# Forklift System — Общие настройки окружения Docker Compose
# ==============================================================================

# База данных PostgreSQL (единая для всех бэкенд-сервисов)
POSTGRES_DB=forklift
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Идентификаторы по умолчанию для оператора
FORKLIFT_ID=1
WAREHOUSE_ID=1

# AnyLogic интеграция (адрес симулятора на хост-машине)
ANYLOGIC_URL=http://host.docker.internal:8080

# Секретные ключи Django
DASHBOARD_SECRET_KEY=
WAREHOUSE_SECRET_KEY=
CONVERTER_SECRET_KEY=

# Режим отладки Django (True / False)
DJANGO_DEBUG=True

# 1C Integration (опционально)
ONEC_API_URL=
ONEC_API_USER=
ONEC_API_PASSWORD=
ONEC_WAREHOUSE=Склад1
